    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <Compile Include="../../src/DynamicIsland/Theme/GlassGpuRenderer.cs" Link="GlassGpuRenderer.cs" />
    <Compile Include="../../src/DynamicIsland/Theme/GlassPixels.cs" Link="GlassPixels.cs" />
  </ItemGroup>
</Project>
