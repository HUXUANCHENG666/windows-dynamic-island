# 统一行尾，避免 Windows 与 Linux 之间来回改文件时整篇 diff。
* text=auto eol=lf

*.sln    text eol=crlf
*.cs     text eol=lf
*.xaml   text eol=lf
*.csproj text eol=lf
*.props  text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.exe  binary
*.dll  binary
