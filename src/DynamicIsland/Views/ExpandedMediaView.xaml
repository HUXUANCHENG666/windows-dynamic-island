<UserControl x:Class="DynamicIsland.Views.ExpandedMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="104"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Head">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtCol" Width="104"/>
                <ColumnDefinition x:Name="GapCol" Width="14"/>
                <ColumnDefinition x:Name="MetaCol" Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="ArtHost" Width="104" Height="104">
                <Rectangle x:Name="Art" RadiusX="24" RadiusY="24"/>
                <Viewbox x:Name="Note" Width="32" Height="32" IsHitTestVisible="False">
                    <Path x:Name="NotePath"/>
                </Viewbox>
                <Grid x:Name="Switcher" Visibility="Collapsed">
                    <Border x:Name="PrevSession" Width="22" Height="22" CornerRadius="11"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Path x:Name="PrevSessionIcon" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10" Stretch="Uniform"/>
                    </Border>
                    <Border x:Name="NextSession" Width="22" Height="22" CornerRadius="11"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Path x:Name="NextSessionIcon" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10" Stretch="Uniform"/>
                    </Border>
                    <Border x:Name="SessionBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                            CornerRadius="8" Padding="6,1" IsHitTestVisible="False">
                        <TextBlock x:Name="SessionCountText" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="Meta" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Title" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Artist" Grid.Row="1" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="ProgressRow" Grid.Row="3" Height="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" FontSize="11" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"/>
                    <Grid x:Name="Track" Grid.Column="1" Height="3" Margin="6,0" VerticalAlignment="Center">
                        <Border x:Name="TrackBack" CornerRadius="1.5"/>
                        <Border x:Name="Progress" HorizontalAlignment="Left" Width="0" CornerRadius="1.5"/>
                    </Grid>
                    <TextBlock x:Name="Duration" Grid.Column="2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="Previous" Width="36" Height="36" CornerRadius="18">
                <Viewbox Width="15" Height="15">
                    <Path x:Name="PreviousIcon"/>
                </Viewbox>
            </Border>
            <Border x:Name="Play" Width="46" Height="46" CornerRadius="23" Margin="26,0">
                <Viewbox Width="16" Height="16">
                    <Path x:Name="PlayIcon"/>
                </Viewbox>
            </Border>
            <Border x:Name="Next" Width="36" Height="36" CornerRadius="18">
                <Viewbox Width="15" Height="15">
                    <Path x:Name="NextIcon"/>
                </Viewbox>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
