<UserControl x:Class="DynamicIsland.Views.TranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <!-- 系统默认的滚动条是浅灰轨道加箭头按钮，放在深色胶囊上很扎眼。
             这里换成一条半透明的细滑块，不占视觉重量。 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" CornerRadius="2" Background="#3DFFFFFF"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Source" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
        <TextBox x:Name="Result" Grid.Row="1" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                 AcceptsReturn="True" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 BorderThickness="0" Background="Transparent" Padding="0" Margin="0,6,0,0"
                 Focusable="False" FocusVisualStyle="{x:Null}" Cursor="Arrow"
                 IsHitTestVisible="False" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        <!-- 用 WrapPanel：竖胶囊宽度不够时按钮自动换行，不会把译文挤出画面。 -->
        <WrapPanel x:Name="Actions" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
            <Border x:Name="Go" Height="30" CornerRadius="15" Padding="14,0" Margin="0,0,6,0">
                <TextBlock x:Name="GoText" Text="翻译" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Auto" Height="30" CornerRadius="15" Padding="10,0" Margin="0,0,6,0">
                <TextBlock x:Name="AutoText" Text="自动" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="ZhEn" Height="30" CornerRadius="15" Padding="10,0" Margin="0,0,6,0">
                <TextBlock x:Name="ZhEnText" Text="中→英" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="EnZh" Height="30" CornerRadius="15" Padding="10,0" Margin="0,0,6,0">
                <TextBlock x:Name="EnZhText" Text="英→中" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Copy" Height="30" CornerRadius="15" Padding="12,0" Margin="0,0,6,0" Visibility="Collapsed">
                <TextBlock x:Name="CopyText" Text="复制" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Close" Height="30" CornerRadius="15" Padding="12,0" Margin="0,0,6,0" Visibility="Collapsed">
                <TextBlock x:Name="CloseText" Text="关闭" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
        </WrapPanel>
    </Grid>
</UserControl>
