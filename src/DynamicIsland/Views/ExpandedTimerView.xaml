<UserControl x:Class="DynamicIsland.Views.ExpandedTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Time" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"/>
        <TextBlock x:Name="Caption" Grid.Row="1" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        <Grid Grid.Row="3" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Minus" Width="36" Height="36" CornerRadius="18" Margin="0,0,8,0">
                <TextBlock Text="−" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Toggle" Grid.Column="1" Height="36" CornerRadius="18" Padding="16,0" Margin="0,0,8,0">
                <TextBlock x:Name="ToggleText" Text="开始" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Reset" Grid.Column="2" Height="36" CornerRadius="18" Padding="14,0" Margin="0,0,8,0">
                <TextBlock x:Name="ResetText" Text="重置" FontSize="13" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Plus" Grid.Column="3" Width="36" Height="36" CornerRadius="18">
                <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <StackPanel x:Name="Modes" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Border x:Name="StopwatchMode" Height="26" CornerRadius="13" Padding="12,0" Margin="0,0,6,0">
                <TextBlock x:Name="StopwatchModeText" Text="秒表" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="CountdownMode" Height="26" CornerRadius="13" Padding="12,0">
                <TextBlock x:Name="CountdownModeText" Text="倒计时" FontSize="12" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
