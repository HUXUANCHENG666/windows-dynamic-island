<UserControl x:Class="DynamicIsland.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <StackPanel x:Name="LiveRow" Orientation="Horizontal" HorizontalAlignment="Left">
                <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveText" Text="摄像头" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border x:Name="CloseCamera" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Cursor="Hand">
                <TextBlock x:Name="CloseText" Text="关闭" FontSize="12" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <Border x:Name="FrameHost" Grid.Row="1" CornerRadius="18" ClipToBounds="True" SizeChanged="FrameHost_SizeChanged">
            <Grid>
                <Canvas x:Name="FrameCanvas" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image x:Name="Preview" Stretch="Uniform" IsHitTestVisible="False"/>
                </Canvas>
                <TextBlock x:Name="Message" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                           FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
