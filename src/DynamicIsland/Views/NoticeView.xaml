<UserControl x:Class="DynamicIsland.Views.NoticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             IsHitTestVisible="False" Focusable="False">
    <Grid Margin="28,0,26,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Width="34" Height="28" VerticalAlignment="Center">
            <Grid x:Name="Speaker">
                <Viewbox Width="22" Height="22">
                    <Grid>
                        <Path x:Name="SpeakerBody"/>
                        <Path x:Name="SpeakerWave" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="SpeakerSlash" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Viewbox>
            </Grid>
            <views:BatteryIcon x:Name="Battery" Visibility="Collapsed"/>
            <Viewbox x:Name="Bell" Width="20" Height="20" Visibility="Collapsed">
                <Path x:Name="BellPath"/>
            </Viewbox>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Title" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Percent" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <TextBlock x:Name="Detail" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            <Grid x:Name="BarHost" Height="4" Margin="0,8,0,0">
                <Border x:Name="BarTrack" CornerRadius="2"/>
                <Border x:Name="BarFill" HorizontalAlignment="Left" CornerRadius="2" Height="4"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
