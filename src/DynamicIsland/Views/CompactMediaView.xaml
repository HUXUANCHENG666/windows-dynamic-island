<UserControl x:Class="DynamicIsland.Views.CompactMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             IsHitTestVisible="False" Focusable="False">
    <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="28" Height="28" VerticalAlignment="Center">
            <Rectangle x:Name="Art" RadiusX="8" RadiusY="8"/>
            <Viewbox x:Name="Note" Width="14" Height="14" IsHitTestVisible="False">
                <Path x:Name="NotePath"/>
            </Viewbox>
        </Grid>
        <views:WaveformControl x:Name="Wave" Grid.Column="2" Width="28" Height="16" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
