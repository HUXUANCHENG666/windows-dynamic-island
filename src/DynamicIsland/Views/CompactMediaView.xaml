<UserControl x:Class="DynamicIsland.Views.CompactMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             IsHitTestVisible="False" Focusable="False">
    <Grid x:Name="Layout" Margin="10,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColArt" Width="Auto"/>
            <ColumnDefinition x:Name="ColGap" Width="*"/>
            <ColumnDefinition x:Name="ColWave" Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="RowArt" Height="*"/>
            <RowDefinition x:Name="RowGap" Height="0"/>
            <RowDefinition x:Name="RowWave" Height="0"/>
        </Grid.RowDefinitions>
        <Grid x:Name="ArtHost" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Rectangle x:Name="Art" RadiusX="8" RadiusY="8"/>
            <Viewbox x:Name="Note" Width="14" Height="14" IsHitTestVisible="False">
                <Path x:Name="NotePath"/>
            </Viewbox>
        </Grid>
        <views:WaveformControl x:Name="Wave" Grid.Column="2" Width="28" Height="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
