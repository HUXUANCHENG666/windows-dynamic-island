<UserControl x:Class="DynamicIsland.Views.LiveTranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CaptionThumbBrush" Color="#80FFFFFF"/>
        <Style x:Key="CaptionPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource CaptionThumbBrush}"
                                CornerRadius="3"
                                Margin="0,1"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionScrollBar" TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource CaptionPageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource CaptionPageButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CaptionThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel x:Name="TitleRow" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="10" Height="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="实时翻译" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="CancelDownload" CornerRadius="12" Padding="10,4" Cursor="Hand" Visibility="Collapsed" Margin="0,0,6,0">
                    <TextBlock x:Name="CancelText" Text="取消" FontSize="12" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="CloseTranslate" CornerRadius="12" Padding="10,4" Cursor="Hand">
                    <TextBlock x:Name="CloseText" Text="关闭" FontSize="12" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
        <ScrollViewer x:Name="CaptionScroll"
                      Grid.Row="2"
                      Margin="0,6,0,0"
                      Padding="0,0,4,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      CanContentScroll="False"
                      ScrollChanged="OnCaptionScrollChanged"
                      PreviewMouseWheel="OnCaptionMouseWheel">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource CaptionScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel x:Name="CaptionList"/>
        </ScrollViewer>
        <Border x:Name="ProgressHost" Grid.Row="3" Height="4" CornerRadius="2" Margin="0,8,0,0" Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Border x:Name="ProgressBar" Height="4" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                <Border x:Name="IndeterminateBar" Height="4" Width="48" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="IndeterminateShift"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
