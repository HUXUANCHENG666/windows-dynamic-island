<Window x:Class="DynamicIsland.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛 · 设置" Width="860" Height="660" MinWidth="620" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13" Foreground="#E8EBEF"
        UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#939EAD"/>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,0"/><Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252B34"/><Setter Property="Foreground" Value="#E8EBEF"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#333C48"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#414D5B"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A7D6C4"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#31594D"/><Setter Property="Foreground" Value="#E0F7EC"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAB4C1"/><Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="#20262F" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C3540"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#253D35"/><Setter TargetName="Surface" Property="BorderBrush" Value="#527B6C"/><Setter Property="Foreground" Value="#D4F0E2"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B4E5D0"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Track" CornerRadius="13" Background="#39414D" BorderThickness="1" BorderBrush="Transparent">
                    <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#E1E6EC" Margin="3" HorizontalAlignment="Left"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#84BDA4"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="#152A22"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#E6FFF3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#ECF0F5"/><Setter Property="Background" Value="#161C24"/>
            <Setter Property="CaretBrush" Value="#C6E9D9"/><Setter Property="SelectionBrush" Value="#436D5C"/>
            <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#323B47"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8DC9AF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#ECF0F5"/><Setter Property="Background" Value="#161C24"/>
            <Setter Property="CaretBrush" Value="#C6E9D9"/><Setter Property="SelectionBrush" Value="#436D5C"/>
            <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
                <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="#323B47" BorderThickness="1">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8DC9AF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="32"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Height="32"><Border Height="4" Background="#36404D" CornerRadius="2"/>
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#8DC9AF" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="18" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Dot" Width="16" Height="16" Fill="#BCE4D3" Stroke="#17372A" StrokeThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                    <Border x:Name="FocusRing" BorderThickness="1" BorderBrush="#A7D6C4" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#465160" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#9EAABA"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#252D38"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A3E36"/><Setter Property="Foreground" Value="#D3F1E2"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8DC9AF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="FrameRoot" Margin="8" CornerRadius="16" BorderBrush="#39424E" BorderThickness="1" Background="#1C222B">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseDown" Background="Transparent" Margin="18,0,8,0">
                <TextBlock Text="灵动岛  /  设置" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Content="×" Width="34" Height="30" MinHeight="30" Padding="0" HorizontalAlignment="Right" Background="Transparent" ToolTip="关闭设置 (Esc)" AutomationProperties.Name="关闭设置" Click="Close_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="12,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="偏好设置" FontSize="20" FontWeight="SemiBold" Margin="12,12,0,22"/>
                    <ListBox x:Name="Navigation" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="Navigation_Changed" AutomationProperties.Name="设置分类" KeyboardNavigation.TabNavigation="Once">
                        <ListBoxItem Content="外观与停靠" Tag="Appearance"/>
                        <ListBoxItem Content="翻译" Tag="Translation"/>
                        <ListBoxItem Content="通知" Tag="Notifications"/>
                        <ListBoxItem Content="隐身与应用" Tag="Apps"/>
                        <ListBoxItem Content="快捷工具" Tag="Tools"/>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="DYNAMIC ISLAND&#10;1.0.0 · 测试分支" FontSize="10" Foreground="#728091" LineHeight="18" Margin="12,12,0,10"/>
                </Grid>
                <Border Grid.Column="1" Background="#131922" CornerRadius="12,0,0,12">
                    <Grid Margin="22,22,14,12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="PageTitle" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Style="{StaticResource Hint}"/></StackPanel>
                        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,12" CanContentScroll="False" KeyboardNavigation.TabNavigation="Continue">
                            <Grid>
                                <StackPanel x:Name="AppearancePage">
                                    <TextBlock Text="岛的大小" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="ScaleSlider" Minimum="85" Maximum="140" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,0,16,0" ValueChanged="Scale_Changed" AutomationProperties.Name="灵动岛大小百分比"/>
                                        <TextBlock x:Name="ScaleValue" Grid.Column="1" MinWidth="45" VerticalAlignment="Center"/>
                                        <Button x:Name="ScaleReset" Grid.Column="2" Content="还原" Margin="8,0,0,0" Click="ScaleReset_Click"/>
                                    </Grid>
                                    <TextBlock Text="按桌面比例调整，拖动和展开仍保持跟手。" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="皮肤" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel><RadioButton x:Name="SkinDefault" GroupName="Skin" Content="近黑 · 经典" Checked="Skin_Changed"/><RadioButton x:Name="SkinGlass" GroupName="Skin" Content="液态玻璃" Checked="Skin_Changed"/></WrapPanel>
                                    <TextBlock Text="玻璃使用局部多点折射；展开时反射薄边上限为 9 DIP，小岛自动限幅。" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="显示器" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel x:Name="MonitorOptions"/>
                                    <TextBlock Text="停靠位置" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel x:Name="DockOptions"/>
                                    <TextBlock Text="也可以直接拖动灵动岛，松手后自动吸附；每个显示器独立记住位置。" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <StackPanel x:Name="TranslationPage" Visibility="Collapsed">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="实时翻译" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="使用现有音频转写与翻译功能。启动后在岛上查看字幕。" Style="{StaticResource Hint}"/></StackPanel><ToggleButton x:Name="LiveToggle" Grid.Column="1" Style="{StaticResource Switch}" Click="Live_Click" AutomationProperties.Name="实时翻译" VerticalAlignment="Top"/></Grid>
                                    <TextBlock Text="翻译方向" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel><RadioButton x:Name="DirAuto" GroupName="Direction" Content="自动" Tag="Auto" Checked="Direction_Changed"/><RadioButton x:Name="DirZhEn" GroupName="Direction" Content="中 → 英" Tag="ChineseToEnglish" Checked="Direction_Changed"/><RadioButton x:Name="DirEnZh" GroupName="Direction" Content="英 → 中" Tag="EnglishToChinese" Checked="Direction_Changed"/></WrapPanel>
                                    <TextBlock Text="翻译接口" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel><RadioButton x:Name="ApiDefault" GroupName="Api" Tag="Default" Content="MyMemory · 免密钥" Checked="Api_Changed"/><RadioButton x:Name="ApiCustom" GroupName="Api" Tag="Custom" Content="OpenAI 兼容" Checked="Api_Changed"/><RadioButton x:Name="ApiLibre" GroupName="Api" Tag="Libre" Content="Libre · 自建" Checked="Api_Changed"/><RadioButton x:Name="ApiAzure" GroupName="Api" Tag="Azure" Content="Azure · F0" Checked="Api_Changed"/><RadioButton x:Name="ApiDeepL" GroupName="Api" Tag="DeepL" Content="DeepL · 额度" Checked="Api_Changed"/></WrapPanel>
                                    <TextBlock x:Name="ProviderHint" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="仅发送到明确选择的源，不自动切源。接口配置单独保存，只做本地校验。有密钥不代表免费，请确认账户计划与剩余额度。" Style="{StaticResource Hint}"/>
                                    <StackPanel x:Name="ApiFields" Margin="0,16,0,0" Visibility="Collapsed">
                                        <Label x:Name="ApiUrlLabel" Target="{Binding ElementName=ApiUrl}" Foreground="#C3CCD7" Content="接口地址" Padding="0,0,0,7"/>
                                        <TextBox x:Name="ApiUrl" TextChanged="ApiText_Changed" AutomationProperties.Name="接口地址"/>
                                        <TextBlock x:Name="ApiUrlHelp" Text="HTTPS；本机服务允许 HTTP。OpenAI 自动补全 /v1/chat/completions。" Style="{StaticResource Hint}"/>
                                        <Label x:Name="ApiModelLabel" Target="{Binding ElementName=ApiModel}" Foreground="#C3CCD7" Content="模型名称" Padding="0,16,0,7"/>
                                        <TextBox x:Name="ApiModel" TextChanged="ApiText_Changed" AutomationProperties.Name="模型名称"/>
                                        <Label x:Name="ApiKeyLabel" Target="{Binding ElementName=ApiKey}" Foreground="#C3CCD7" Content="API 密钥" Padding="0,16,0,7"/>
                                        <PasswordBox x:Name="ApiKey" PasswordChanged="ApiKey_Changed" AutomationProperties.Name="API 密钥"/>
                                        <Label x:Name="ApiRegionLabel" Target="{Binding ElementName=ApiRegion}" Foreground="#C3CCD7" Content="Azure 资源区域（global 可留空）" Padding="0,16,0,7"/>
                                        <TextBox x:Name="ApiRegion" TextChanged="ApiText_Changed" AutomationProperties.Name="Azure 资源区域"/>
                                        <TextBlock Text="保留现有本地存储方式；密钥不写入日志。" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ApiStatus" Foreground="#D5BA89" Margin="0,14,0,10" AutomationProperties.LiveSetting="Polite"/>
                                    <WrapPanel><Button x:Name="ApiSave" Content="保存接口配置" Style="{StaticResource AccentButton}" Click="ApiSave_Click" Margin="0,0,8,8"/><Button x:Name="ApiRevert" Content="撤销接口修改" Click="ApiRevert_Click" Margin="0,0,0,8"/></WrapPanel>
                                </StackPanel>
                                <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="系统通知" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="将支持的系统通知送到灵动岛。仅在你主动开启时请求原有通知权限。" Style="{StaticResource Hint}"/></StackPanel><ToggleButton x:Name="NoticeToggle" Grid.Column="1" Style="{StaticResource Switch}" Click="Notice_Click" AutomationProperties.Name="系统通知" VerticalAlignment="Top"/></Grid>
                                    <TextBlock Text="不打断当前操作" Style="{StaticResource SectionTitle}"/><TextBlock Text="保持现有通知展示和收起行为；关闭后不会影响翻译、计时和媒体功能。" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <StackPanel x:Name="AppsPage" Visibility="Collapsed">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="临时隐身" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="将岛收成小点；仍可从托盘恢复。" Style="{StaticResource Hint}"/></StackPanel><ToggleButton x:Name="StealthToggle" Grid.Column="1" Style="{StaticResource Switch}" Click="Stealth_Click" AutomationProperties.Name="临时隐身" VerticalAlignment="Top"/></Grid>
                                    <TextBlock Text="应用隐身名单" Style="{StaticResource SectionTitle}"/><TextBlock Text="这些应用位于前台时自动收起灵动岛。不读取窗口文字。" Style="{StaticResource Hint}"/>
                                    <Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HideName" KeyDown="HideName_KeyDown" AutomationProperties.Name="进程名称"/><Button x:Name="HideAdd" Grid.Column="1" Content="添加" Margin="8,0,0,0" Click="HideAdd_Click"/></Grid>
                                    <WrapPanel><Button x:Name="HideBrowse" Content="选择程序…" Click="HideBrowse_Click" Margin="0,0,8,8"/><Button x:Name="HideCurrent" Content="添加先前应用" Click="HideCurrent_Click" Margin="0,0,8,8"/><Button x:Name="HideRefresh" Content="刷新运行列表" Click="HideRefresh_Click" Margin="0,0,0,8"/></WrapPanel>
                                    <TextBlock x:Name="HideStatus" Foreground="#D5BA89" Margin="0,2,0,8" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="已加入 · 点击移除" Style="{StaticResource SectionTitle}"/><WrapPanel x:Name="HideList"/>
                                    <TextBlock Text="正在运行 · 点击添加" Style="{StaticResource SectionTitle}"/><WrapPanel x:Name="RunningApps"/>
                                </StackPanel>
                                <StackPanel x:Name="ToolsPage" Visibility="Collapsed">
                                    <TextBlock Text="翻译" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <WrapPanel><Button x:Name="ActTranslate" Content="翻译剪贴板" Tag="clipboard" Click="Tool_Click" Margin="0,0,8,8"/><Button x:Name="ActRecall" Content="上次翻译" Tag="recall" Click="Tool_Click" Margin="0,0,8,8"/><Button x:Name="ActLiveTranslate" Content="实时翻译" Tag="live" Click="Tool_Click" Margin="0,0,8,8"/></WrapPanel>
                                    <TextBlock Text="计时与捕捉" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel><Button x:Name="ActCamera" Content="摄像头" Tag="camera" Click="Tool_Click" Margin="0,0,8,8"/><Button x:Name="ActStopwatch" Content="秒表" Tag="stopwatch" Click="Tool_Click" Margin="0,0,8,8"/><Button x:Name="ActFocus" Content="专注 25 分钟" Tag="focus" Click="Tool_Click" Margin="0,0,8,8"/></WrapPanel>
                                    <TextBlock Text="诊断" Style="{StaticResource SectionTitle}"/><Button x:Name="ActLog" Content="打开日志" Tag="log" Click="Tool_Click" HorizontalAlignment="Left"/>
                                    <TextBlock Text="日志保留现有本地诊断，不包含接口密钥和屏幕内容。" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock x:Name="FooterStatus" Grid.Row="2" Text="偏好更改立即生效 · 接口配置需单独保存" FontSize="11" Foreground="{StaticResource Muted}" Margin="24,0,24,0" VerticalAlignment="Center"/>
            <ResizeGrip Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18" Opacity="0.5"/>
            <Border x:Name="UnsavedPrompt" Grid.RowSpan="3" Background="#F01A222C" CornerRadius="16" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel MaxWidth="340" Margin="24" VerticalAlignment="Center">
                    <TextBlock Text="接口配置尚未保存" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="保存后关闭，或放弃本次接口修改。其他偏好已即时生效。" Style="{StaticResource Hint}" Margin="0,12,0,20"/>
                    <Button x:Name="SaveAndClose" Content="保存并关闭" Style="{StaticResource AccentButton}" Click="SaveClose_Click" Margin="0,0,0,8"/>
                    <Button x:Name="DiscardAndClose" Content="放弃接口修改并关闭" Click="DiscardClose_Click" Margin="0,0,0,8"/>
                    <Button x:Name="ContinueEditing" Content="继续编辑" Click="Continue_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
