<Window x:Class="DynamicIsland.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛设置"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <Border x:Name="Card" CornerRadius="28" Margin="16" Padding="22,20,22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
                <Grid x:Name="DragHeader" Margin="0,0,0,16" Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path x:Name="Gear" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock x:Name="Heading" Text="设置" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="CloseButton" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Right" Cursor="Hand">
                        <TextBlock Text="×" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="NoticeLabel" Text="通知" FontSize="12" Margin="2,0,0,8"/>
                <Border x:Name="NoticeRow" CornerRadius="16" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="NoticeTitle" Text="在岛上显示通知中心" FontSize="14"/>
                            <TextBlock x:Name="NoticeDetail" Text="只读系统通知，不挂钩聊天软件。" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border x:Name="NoticeToggle" Width="44" Height="26" CornerRadius="13" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                            <Border x:Name="NoticeKnob" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="DirectionLabel" Text="翻译方向" FontSize="12" Margin="2,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border x:Name="DirAuto" CornerRadius="14" Padding="12,7" Margin="0,0,8,0" Cursor="Hand">
                        <TextBlock x:Name="DirAutoText" Text="自动" FontSize="13"/>
                    </Border>
                    <Border x:Name="DirZhEn" CornerRadius="14" Padding="12,7" Margin="0,0,8,0" Cursor="Hand">
                        <TextBlock x:Name="DirZhEnText" Text="中→英" FontSize="13"/>
                    </Border>
                    <Border x:Name="DirEnZh" CornerRadius="14" Padding="12,7" Cursor="Hand">
                        <TextBlock x:Name="DirEnZhText" Text="英→中" FontSize="13"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="HideLabel" Text="隐身名单" FontSize="12" Margin="2,0,0,8"/>
                <TextBlock x:Name="HideHint" Text="这些程序在这块屏幕上成为前台时，岛会收成小点。在下面输入任务管理器里的进程名即可加入，不用带 .exe，例如 chrome、msedge、WeChat、notepad。也可以点正在运行的程序。" FontSize="12" Margin="2,0,0,8" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HideNameBox" CornerRadius="14" Margin="0,0,8,0">
                        <Grid>
                            <TextBlock x:Name="HideNameHint" Text="例如 chrome" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="HideName" Height="36" FontSize="13" Padding="12,6,12,6" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"/>
                        </Grid>
                    </Border>
                    <Border x:Name="HideAdd" Grid.Column="1" CornerRadius="14" Padding="14,8" Margin="0,0,8,0" Cursor="Hand">
                        <TextBlock x:Name="HideAddText" Text="加入" FontSize="13" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="HideBrowse" Grid.Column="2" CornerRadius="14" Padding="12,8" Cursor="Hand">
                        <TextBlock x:Name="HideBrowseText" Text="选择…" FontSize="13" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="HideStatus" FontSize="12" Margin="2,0,0,8" TextWrapping="Wrap"/>
                <Border x:Name="HideCurrent" CornerRadius="14" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,8" Cursor="Hand" Visibility="Collapsed">
                    <TextBlock x:Name="HideCurrentText" Text="把刚才的程序加入名单" FontSize="13"/>
                </Border>
                <Grid Margin="2,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RunningLabel" Text="正在运行，点一下就加入" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                    <Border x:Name="HideRefresh" Grid.Column="1" CornerRadius="10" Padding="8,3" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock x:Name="HideRefreshText" Text="刷新" FontSize="12"/>
                    </Border>
                </Grid>
                <WrapPanel x:Name="RunningApps" Margin="0,0,0,8"/>
                <StackPanel x:Name="HideList" Margin="0,0,0,16"/>

                <TextBlock x:Name="ToolLabel" Text="工具" FontSize="12" Margin="2,0,0,8"/>
                <WrapPanel>
                    <Border x:Name="ActTranslate" Style="{x:Null}" CornerRadius="14" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                        <TextBlock x:Name="ActTranslateText" Text="翻译剪贴板" FontSize="13"/>
                    </Border>
                    <Border x:Name="ActRecall" CornerRadius="14" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                        <TextBlock x:Name="ActRecallText" Text="上次译文" FontSize="13"/>
                    </Border>
                    <Border x:Name="ActCamera" CornerRadius="14" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                        <TextBlock x:Name="ActCameraText" Text="摄像头" FontSize="13"/>
                    </Border>
                    <Border x:Name="ActStopwatch" CornerRadius="14" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                        <TextBlock x:Name="ActStopwatchText" Text="秒表" FontSize="13"/>
                    </Border>
                    <Border x:Name="ActFocus" CornerRadius="14" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                        <TextBlock x:Name="ActFocusText" Text="专注 25 分钟" FontSize="13"/>
                    </Border>
                    <Border x:Name="ActLog" CornerRadius="14" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                        <TextBlock x:Name="ActLogText" Text="打开日志" FontSize="13"/>
                    </Border>
                </WrapPanel>
        </StackPanel>
    </Border>
</Window>
