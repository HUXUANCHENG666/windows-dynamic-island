<Window x:Class="DynamicIsland.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        Title="灵动岛"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        Opacity="0">
    <Canvas x:Name="Root" ClipToBounds="False">
        <Grid x:Name="PillHost" ClipToBounds="False">
            <Path x:Name="Pill"/>
            <Path x:Name="PillStroke" IsHitTestVisible="False"/>
            <Grid x:Name="ContentHost">
                <views:CompactMediaView x:Name="CompactMedia"/>
                <views:CompactTimerView x:Name="CompactTimer"/>
                <views:ExpandedIdleView x:Name="ExpandedIdle"/>
                <views:ExpandedMediaView x:Name="ExpandedMedia"/>
                <views:ExpandedTimerView x:Name="ExpandedTimer"/>
                <views:NoticeView x:Name="VolumeNotice"/>
                <views:NoticeView x:Name="BatteryNotice"/>
                <views:NoticeView x:Name="ToastNotice"/>
            </Grid>
        </Grid>
    </Canvas>
</Window>
