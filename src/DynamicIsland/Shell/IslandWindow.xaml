<Window x:Class="DynamicIsland.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        Title="灵动岛"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        Opacity="0">
    <Canvas x:Name="Root" ClipToBounds="False">
        <Grid x:Name="PillHost" ClipToBounds="False">
            <Path x:Name="Pill"/>
            <Grid x:Name="GlassHost" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">
                <Path x:Name="GlassScrim"/>
                <Image x:Name="GlassShade" Stretch="Fill" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                <Image x:Name="GlassRefraction" Stretch="Fill" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                <Path x:Name="GlassThickness"/>
                <Path x:Name="GlassSpecular"/>
                <Path x:Name="GlassLip"/>
                <Ellipse x:Name="GlassBead" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-18"/>
                            <TranslateTransform x:Name="GlassBeadShift"/>
                            <TranslateTransform x:Name="GlassBeadLag"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="GlassBlobA" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="GlassBlobARotate" Angle="-22"/>
                            <TranslateTransform x:Name="GlassBlobAShift"/>
                            <TranslateTransform x:Name="GlassBlobALag"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="GlassBlobB" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="GlassBlobBRotate" Angle="28"/>
                            <TranslateTransform x:Name="GlassBlobBShift"/>
                            <TranslateTransform x:Name="GlassBlobBLag"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="GlassStreak" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="GlassStreakRotate" Angle="-32"/>
                            <TranslateTransform x:Name="GlassStreakShift"/>
                            <TranslateTransform x:Name="GlassStreakLag"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <Path x:Name="PillStroke" IsHitTestVisible="False"/>
            <Grid x:Name="ContentHost">
                <views:CompactMediaView x:Name="CompactMedia"/>
                <views:CompactTimerView x:Name="CompactTimer"/>
                <views:ExpandedIdleView x:Name="ExpandedIdle"/>
                <views:ExpandedMediaView x:Name="ExpandedMedia"/>
                <views:ExpandedTimerView x:Name="ExpandedTimer"/>
                <views:NoticeView x:Name="VolumeNotice"/>
                <views:NoticeView x:Name="BatteryNotice"/>
                <views:NoticeView x:Name="ToastNotice"/>
                <views:TranslateView x:Name="TranslateNotice"/>
                <views:CameraView x:Name="CameraNotice"/>
                <views:LiveTranslateView x:Name="LiveTranslateNotice"/>
            </Grid>
        </Grid>
    </Canvas>
</Window>
