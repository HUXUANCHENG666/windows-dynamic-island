<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>灵动岛</Product>
    <AssemblyTitle>灵动岛</AssemblyTitle>
    <Company>Dynamic Island</Company>
    <Description>停靠在屏幕顶部的灵动岛。</Description>
    <Copyright>Copyright © 2026</Copyright>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DynamicIsland.Core\DynamicIsland.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!--
    Whisper.net looks for natives at ./runtimes/win-x64 next to the exe.
    A single-file publish does not extract these content files to that path,
    so copy them beside the published exe. The zip step must include this folder.
  -->
  <Target Name="CopyWhisperNativeBesideApp" AfterTargets="Publish">
    <ItemGroup>
      <_WhisperNative Include="$(OutDir)runtimes\win-x64\*.dll" />
    </ItemGroup>
    <ItemGroup Condition="'@(_WhisperNative)' == ''">
      <_WhisperNative Include="$(NuGetPackageRoot)whisper.net.runtime\1.9.1\build\win-x64\*.dll" />
    </ItemGroup>
    <Error Condition="'@(_WhisperNative)' == ''" Text="Whisper native libraries were not found to copy beside the published app." />
    <MakeDir Directories="$(PublishDir)runtimes\win-x64" />
    <Copy SourceFiles="@(_WhisperNative)" DestinationFolder="$(PublishDir)runtimes\win-x64" SkipUnchangedFiles="true" />
  </Target>
</Project>
